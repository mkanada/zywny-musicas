app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cache do Kotlin/Gradle (o build do Android).
/android/.kotlin/

# Widget Preview related
.widget_preview/

# Verovio engraving resources — generated from verovio_flutter_bridge, regenerable
# (run tool/build_verovio_assets.sh).
/assets/verovio_data.zip
/assets/classicos.zywny

# The app no longer embeds hymns (phase B: installable libraries). Kept out of
# the repository in case old copies are still on disk — third-party scores.
/assets/hinos/

# libverovio.so for Android (X01) — generated from verovio_flutter_bridge,
# regenerable (run tool/build_verovio_android.sh / `just native-android`).
/android/app/src/main/jniLibs/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Verovio wasm toolkit for the Web (W02) — generated from verovio_flutter_bridge,
# regenerable (run tool/build_verovio_web.sh).
/web/verovio/

# Web sound engine (W04): esbuild output and npm deps, regenerable
# (run tool/build_audio_web.sh).
/web/audio/
/dist/

# Chaves das bibliotecas (D-BIB-CIFRA): nunca vao para o remoto.
/keys/

# Chave de assinatura do Android (upload key do Google Play). A de release
# mora em keys/ (acima); estas regras protegem tambem um .jks criado em
# outro lugar do repositorio.
*.jks
*.keystore
key.properties
android-release.properties
